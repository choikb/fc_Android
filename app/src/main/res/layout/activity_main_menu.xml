<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 로고 이미지 -->
        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/logo1"
            android:contentDescription="앱 로고"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal" />

        <!-- 사용자 정보 섹션 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/labelAffiliation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="소속"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="본부A"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/labelRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="계급"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="계급1"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/labelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="성명"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="홍길동"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/labelCaseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="화재명"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewCaseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="화재명 정보"
                android:textSize="18sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- 주요 버튼 섹션 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center">

            <Button
                android:id="@+id/buttonGoCapture"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:text="촬영 시작"
                android:textSize="25sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:elevation="4dp" />

            <Button
                android:id="@+id/buttonGoSelectMedia"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:text="미디어 선택"
                android:textSize="25sp"
                android:backgroundTint="#03A9F4"
                android:textColor="#FFFFFF"
                android:elevation="4dp" />
        </LinearLayout>

        <!-- 로그아웃 버튼 -->
        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="로그아웃"
            android:textSize="18sp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            android:elevation="4dp" />
    </LinearLayout>
</ScrollView>
