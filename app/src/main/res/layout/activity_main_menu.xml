<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 로고 이미지 -->
        <ImageView
            android:id="@+id/imageViewLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/logo1"
            android:contentDescription="앱 로고"
            android:layout_marginBottom="5dp"
            android:layout_gravity="center_horizontal" />

        <!-- 사용자 정보 섹션 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border"
            android:padding="16dp"
            android:layout_marginBottom="10dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/labelAffiliation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="소속"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="본부A"
                android:textAlignment="center"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:textColor="#333333" />
<!--
            <TextView
                android:id="@+id/labelRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="계급"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="계급1"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:textColor="#333333" />
-->
            <TextView
                android:id="@+id/labelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="성명"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="홍길동"
                android:textAlignment="center"
                android:textSize="18sp"
                android:paddingBottom="12dp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/labelCaseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="화재명"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/textViewCaseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="화재명 정보"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textColor="#333333" />
        </LinearLayout>

        <!-- 주요 버튼 섹션 - 그리드 레이아웃으로 변경 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="주요 기능"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"
            android:gravity="center" />
            
        <!-- 상단 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/buttonGoCapture"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="촬영 시작"
                android:textSize="20sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:elevation="4dp"
                android:drawableTop="@android:drawable/ic_menu_camera"
                android:paddingTop="16dp" />

            <Button
                android:id="@+id/buttonGoSelectMedia"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="미디어 선택"
                android:textSize="20sp"
                android:backgroundTint="#03A9F4"
                android:textColor="#FFFFFF"
                android:elevation="4dp"
                android:drawableTop="@android:drawable/ic_menu_gallery"
                android:paddingTop="16dp" />
        </LinearLayout>
        
        <!-- 중간 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/buttonWriteReport"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:text="보고서 작성"
                android:textSize="20sp"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:elevation="4dp"
                android:drawableTop="@android:drawable/ic_menu_edit"
                android:paddingTop="16dp" />
        </LinearLayout>


        <!-- 하단 버튼 섹션 (홈 버튼과 로그아웃 버튼) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <!-- 홈 버튼 -->
            <Button
                android:id="@+id/buttonHome"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="홈"
                android:textSize="16sp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:elevation="4dp"
                android:drawableStart="@android:drawable/ic_menu_revert"
                android:paddingStart="24dp"
                android:gravity="center" />

            <!-- 로그아웃 버튼 -->
            <Button
                android:id="@+id/buttonLogout"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="로그아웃"
                android:textSize="16sp"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:elevation="4dp"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:paddingStart="24dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
