<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- 사진 표시 영역 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="475dp"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/imageViewPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <com.example.myapplication.DrawView
            android:id="@+id/drawView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 편집 모드 체크박스 -->
    <CheckBox
        android:id="@+id/checkBoxEditMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="편집 모드 활성화"
        android:textSize="16sp"
        android:textColor="#333333"
        android:padding="8dp"
        android:layout_marginBottom="12dp"
        android:buttonTint="@android:color/holo_blue_dark"
        android:gravity="center" />

    <!-- 색상 선택 및 아이콘 선택 -->
    <LinearLayout
        android:id="@+id/colorPickerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:padding="8dp">

        <!-- 색상 선택 영역 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="펜 색상:"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginEnd="8dp" />

        <!-- 클릭하면 색상 선택 다이얼로그 표시 -->
        <View
            android:id="@+id/viewCurrentColor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/holo_red_light"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true" />
        
        <!-- 아이콘 선택 스피너 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이콘:"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginEnd="8dp" />
            
        <Spinner
            android:id="@+id/spinnerIconSelect"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            style="@android:style/Widget.Holo.Light.Spinner" />
            
        <!-- 아이콘 색상 미리보기 -->
        <View
            android:id="@+id/viewIconColor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/holo_red_light"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />
            
        <!-- 지우개 버튼 -->
        <Button
            android:id="@+id/buttonEraser"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="지우개"
            android:textSize="12sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- 메모 입력란 -->
    <EditText
        android:id="@+id/editTextMemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="메모를 입력하세요"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:minLines="2" />

    <!-- 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:layout_weight="1"
            android:text="취소"
            android:textSize="22sp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:elevation="4dp" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:layout_weight="1"
            android:text="저장"
            android:textSize="22sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:elevation="4dp" />
    </LinearLayout>

</LinearLayout>
